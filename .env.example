# Klucz do Groq Speech-to-Text (https://console.groq.com/keys).
# Używany WYŁĄCZNIE przez narzędzia CLI w tools/ — rozszerzenie Chrome nie ma
# dostępu do plików z dysku i czyta swój klucz z ustawień w popupie.
GROQ_API_KEY=gsk_...

# Klucz do Experiential Labs (https://platform.experientiallabs.ai/api-keys).
# Używany przez aplikację natywną w trybie --probe. Sama aplikacja czyta klucz
# z Keychaina (Ustawienia → Asystent), nie z tego pliku.
XPL_API_KEY=xpl_...
